# ==============================================================================
# TalkLab 2.0 - Production Security & Environment Configuration
# ==============================================================================
# NEVER prefix administrative secrets with NEXT_PUBLIC_.
# Ensure this file is never committed to source control (see .gitignore).

# Direct PIN comparison fallback (used with crypto.timingSafeEqual)
ADMIN_PORTAL_PIN="your-secure-admin-pin-here"

# Bcrypt hash of the Moderator / Facilitator Passcode (12 rounds recommended).
# Generate using: node scripts/generate-pin-hash.mjs "your-passcode"
# TIP: In .env files, dollar signs ($) can trigger variable interpolation.
# TalkLab supports base64-encoded hashes (prefix with base64:) or standard/escaped hashes.
ADMIN_PIN_HASH="base64:your-base64-encoded-bcrypt-hash-here"


# 256-bit cryptographically secure secret used for signing HttpOnly JWT session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_JWT_SECRET="generate-32-byte-hex-secret-here"

# Session Inactivity Timeout in seconds (default: 7200s = 2 hours)
ADMIN_SESSION_MAX_AGE_SECONDS=7200

# Private OpenWA WhatsApp Dispatch Engine Credentials (Server-Side Only)
OPENWA_API_KEY="your-openwa-api-key-here"
OPENWA_BASE_URL="http://127.0.0.1:2785"
OPENWA_DEFAULT_SESSION_ID="default-session-id"

# Rate Limiter Configuration
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOCKOUT_MINUTES=15
